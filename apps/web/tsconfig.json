{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist-types",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test", "e2e", "*.ts", "../../levels/**/*.json", "../../themes/*.json"],
  "references": [{ "path": "../../packages/engine" }, { "path": "../../packages/themes" }]
}
