{
  "name": "pour-decisions",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
